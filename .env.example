# =========================================================
# RUNTIME
# =========================================================

NODE_ENV=development

API_HTTP_PORT=3000
WEB_HTTP_PORT=8080

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

TRUST_PROXY_HOPS=0
ADMIN_SESSION_TTL_HOURS=12


# =========================================================
# BASE DE DATOS - MARIADB / MYSQL LOCAL
# =========================================================
# Docker expone MariaDB en 3307.
# EN HOSTINGER estos valores se reemplazarán por los reales.

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307
DATABASE_USER=isocal_app
DATABASE_PASSWORD="cambia-esta-contrasena"
DATABASE_NAME=isocal_platform
DATABASE_SSL=false
DATABASE_CONNECTION_LIMIT=10


