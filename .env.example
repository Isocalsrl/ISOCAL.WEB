# Runtime
NODE_ENV=development
API_HTTP_PORT=3000
WEB_HTTP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
ADMIN_SESSION_TTL_HOURS=12

# Base de datos local (Docker publica MariaDB en 3307 para evitar conflictos con MySQL/MariaDB instalado)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307
DATABASE_USER=isocal_app
DATABASE_PASSWORD="cambia-esta-contrasena"
DATABASE_NAME=isocal_platform
DATABASE_SSL=false
DATABASE_CONNECTION_LIMIT=10

# En Hostinger también puedes usar DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME.
# Hostinger normalmente usa localhost:3306 para la base administrada.

# Superadministrador inicial
BOOTSTRAP_SUPER_ADMIN_NAME=Administrador ISOCAL
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD="cambia-esta-contrasena"

# Archivos
FILE_STORAGE_ROOT=backend/storage

# Email transaccional (opcionales durante desarrollo)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
QUOTATION_INTERNAL_EMAIL=

# Empresa
COMPANY_LEGAL_NAME=ISOCAL
COMPANY_TAX_ID=00000000000
COMPANY_PHONE=000000000
COMPANY_WHATSAPP=000000000
COMPANY_EMAIL=contacto@example.com
COMPANY_OPERATIONS_EMAIL=operaciones@example.com
COMPANY_OPERATIONS_PHONE=000000000
COMPANY_WEBSITE=https://example.com
COMPANY_OFFICE_ADDRESS=
COMPANY_LAB_ADDRESS_PRIMARY=Dirección de laboratorio principal
COMPANY_LAB_ADDRESS_SECONDARY=Dirección de laboratorio secundaria
COMPANY_INSTAGRAM_URL=
COMPANY_FACEBOOK_URL=
COMPANY_YOUTUBE_URL=
COMPANY_LINKEDIN_URL=
COMPANY_TIKTOK_URL=

# Cotización
QUOTATION_VALIDITY_DAYS=7
QUOTATION_PAYMENT_TERMS=Contado
QUOTATION_SERVICE_TIME=3 días calendario
QUOTATION_DELIVERABLES=1 Certificado de calibración por equipo
QUOTATION_LABORATORY=ISOCAL

# Datos de pago
PAYMENT_ACCOUNT_HOLDER=ISOCAL
PAYMENT_BCP_ACCOUNT_PEN=00000000000000
PAYMENT_BCP_CCI_PEN=00000000000000000000
PAYMENT_BCP_DETRACTION_ACCOUNT=00000000000
PAYMENT_YAPE_NUMBER=000000000
