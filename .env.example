# Docker Compose - entorno completo
APP_PORT=8080
POSTGRES_PORT=5433

POSTGRES_USER=isocal
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=isocal

# En local puede permanecer development. En VPS usa production y HTTPS.
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:8080
TRUST_PROXY_HOPS=1
ADMIN_SESSION_DURATION_HOURS=12

# Primer super_admin de una base nueva. Los tres valores deben ir juntos.
# Después del primer arranque, retira las tres variables BOOTSTRAP_ADMIN_* del entorno.
BOOTSTRAP_ADMIN_NAME=Administrador ISOCAL
BOOTSTRAP_ADMIN_EMAIL=admin@isocal.pe
BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password

RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=ventas@isocal.pe

ISOCAL_LEGAL_NAME=
ISOCAL_RUC=
ISOCAL_PHONE=+51 991 084 825
ISOCAL_EMAIL=ventas@isocal.pe
ISOCAL_WEBSITE=https://www.isocal.pe
ISOCAL_ADDRESS=
