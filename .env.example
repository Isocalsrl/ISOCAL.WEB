# Copia este archivo como .env en la raíz. Todos los valores siguientes son ejemplos.

# Aplicación
NODE_ENV=development
WEB_HTTP_PORT=8080
API_HTTP_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
TRUST_PROXY_HOPS=0
ADMIN_SESSION_TTL_HOURS=12

# Base de datos
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_USER=isocal_app
DATABASE_PASSWORD="replace-with-a-long-random-password#safe-example"
DATABASE_NAME=isocal_platform
DATABASE_SSL=false

# Archivos persistentes
FILE_STORAGE_ROOT=backend/storage

# Bootstrap inicial
BOOTSTRAP_SUPER_ADMIN_NAME=Superadministrador ISOCAL
BOOTSTRAP_SUPER_ADMIN_EMAIL=superadmin@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD="replace-with-a-long-random-password#safe-example"

# Correo
RESEND_API_KEY=re_example_key
EMAIL_FROM="ISOCAL <cotizaciones@example.com>"
EMAIL_REPLY_TO=ventas@example.com
# Opcional. Si se deja vacío, la cotización se envía únicamente al cliente.
QUOTATION_INTERNAL_EMAIL=

# Frontend público
VITE_PUBLIC_API_URL=http://localhost:3000

# Empresa
COMPANY_LEGAL_NAME=EMPRESA DE EJEMPLO S.A.C.
COMPANY_TAX_ID=20000000001
COMPANY_PHONE=+51 900 000 000
COMPANY_WHATSAPP=+51 900 000 000
COMPANY_EMAIL=contacto@example.com
COMPANY_OPERATIONS_EMAIL=operaciones@example.com
COMPANY_OPERATIONS_PHONE=+51 900 000 001
COMPANY_WEBSITE=https://example.com
COMPANY_OFFICE_ADDRESS=Dirección de ejemplo
COMPANY_LAB_ADDRESS_PRIMARY=Dirección del laboratorio principal
COMPANY_LAB_ADDRESS_SECONDARY=Dirección del laboratorio secundario
COMPANY_INSTAGRAM_URL=https://www.instagram.com/example/
COMPANY_FACEBOOK_URL=https://www.facebook.com/example/
COMPANY_YOUTUBE_URL=https://www.youtube.com/@example
COMPANY_LINKEDIN_URL=https://www.linkedin.com/company/example/
COMPANY_TIKTOK_URL=

# Cotizaciones
QUOTATION_VALIDITY_DAYS=7
QUOTATION_PAYMENT_TERMS=Contado
QUOTATION_SERVICE_TIME=3 días calendario
QUOTATION_DELIVERABLES=1 Certificado de calibración por equipo
QUOTATION_LABORATORY=ISOCAL, red de laboratorios Acreditados INACAL/A2LA

# Datos de pago
PAYMENT_ACCOUNT_HOLDER=EMPRESA DE EJEMPLO S.A.C.
PAYMENT_BCP_ACCOUNT_PEN=0000000000000
PAYMENT_BCP_CCI_PEN=00000000000000000000
PAYMENT_BCP_DETRACTION_ACCOUNT=00 000 000000
PAYMENT_YAPE_NUMBER=900000000
